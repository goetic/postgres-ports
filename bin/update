#!/usr/bin/env sh

get_arch() {
  echo "$(uname -p)"
}

main() {
  local arch="$(get_arch)"

  echo "== Updating default ports tree…" >&2
  poudriere ports -u
  echo

  echo "== Updating 14.4-RELEASE jail…" >&2
  poudriere jail -u -j "144${arch}"
  echo

  echo "== Updating 15.1-RELEASE jail…" >&2
  poudriere jail -u -j "151${arch}"
  echo
}

main
