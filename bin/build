#!/usr/bin/env sh

get_arch() {
  echo "$(uname -p)"
}

main() {
  local arch="$(get_arch)"

  ./bin/update
  echo

  echo "== Building 14.4-RELEASE…" >&2
  poudriere bulk -f packages-default -O postgres -j "144${arch}"
  echo

  echo "== Building 15.1-RELEASE…" >&2
  poudriere bulk -f packages-default -O postgres -j "151${arch}"
}

main
